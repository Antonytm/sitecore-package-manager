{
  "name": "sitecore-package-manager",
  "version": "0.1.0",
  "private": true,
  "description": "Sitecore Marketplace app to install and create classic-format Sitecore packages (items) for SitecoreAI / XM Cloud.",
  "engines": {
    "node": ">=18.18.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:verify": "node --eval \"process.env.NEXT_DIST_DIR='.next-verify'; require('child_process').execSync('next build', { stdio: 'inherit' })\""
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@mdi/js": "^7.4.47",
    "@sitecore-marketplace-sdk/client": "^0.2.0",
    "@sitecore-marketplace-sdk/xmc": "^0.2.0",
    "@tailwindcss/postcss": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "fflate": "^0.8.3",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.47.0",
    "next": "^15.4.6",
    "next-themes": "^0.4.6",
    "postcss": "^8.5.28",
    "radix-ui": "^1.6.7",
    "react": "^19.1.1",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.1.1",
    "react-resizable-panels": "^3.0.3",
    "react-select": "^5.10.2",
    "recharts": "^2.15.4",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^24.2.0",
    "@types/react": "19.1.9",
    "typescript": "5.9.2",
    "vitest": "^4.1.9"
  }
}
