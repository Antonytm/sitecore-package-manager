# Copy to .env.local and fill in when registering the app in the Sitecore Cloud Portal.
# A pure client-side standalone app needs little/no config, but these are used by the
# full-stack / custom-auth flow and when running locally over https.

# The application id assigned when you register the app in the Cloud Portal.
NEXT_PUBLIC_SITECORE_APP_ID=

# Base URL the portal embeds (use https locally, e.g. https://localhost:3000 or a custom host).
NEXT_PUBLIC_APP_BASE_URL=https://localhost:3000
